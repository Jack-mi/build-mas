{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "codexwright": {
        "type": "local",
        "command": ["python", "-m", "codexwright.mcp_server"],
        "environment": {"CODEXWRIGHT_ALLOW_APPLY": "1"},
        "disabled": false,
        "codemode": false
      }
    }
  },
  "permissions": [{"action": "codexwright_codexwright_apply", "resource": "*", "effect": "ask"}],
  "instructions": ["codexwright-host.md"]
}
