{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "buildmas": {
        "type": "local",
        "command": ["python", "-m", "build_mas.mcp_server"],
        "environment": {"BUILD_MAS_ALLOW_APPLY": "1"},
        "disabled": false,
        "codemode": false
      }
    }
  },
  "permissions": [{"action": "buildmas_buildmas_apply", "resource": "*", "effect": "ask"}],
  "instructions": ["build-mas-host.md"]
}
