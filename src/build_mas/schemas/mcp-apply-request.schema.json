{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "proposal_id": {
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,79}$",
      "title": "Proposal Id",
      "type": "string"
    },
    "idempotency_key": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Idempotency Key",
      "type": "string"
    }
  },
  "required": [
    "proposal_id",
    "idempotency_key"
  ],
  "title": "PublicApplyRequest",
  "type": "object"
}
